{
  "components": {
    "schemas": {
      "AssuranceLevel": {
        "enum": [
          "LOW",
          "STANDARD",
          "HIGH"
        ],
        "title": "AssuranceLevel",
        "type": "string"
      },
      "AuthenticatedIdentityContext": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "agent_id": {
            "format": "uuid",
            "title": "Agent Id",
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "agent_id"
        ],
        "title": "AuthenticatedIdentityContext",
        "type": "object"
      },
      "AuthorizeAction": {
        "additionalProperties": false,
        "properties": {
          "action_schema_version": {
            "const": "action.material.v1",
            "default": "action.material.v1",
            "title": "Action Schema Version",
            "type": "string"
          },
          "ephemeral": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "description": "Transient action context that must not be treated as durable fact.",
            "title": "Ephemeral",
            "type": "object"
          },
          "material": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "description": "Persistent, auditable action facts that can affect authorization.",
            "title": "Material",
            "type": "object"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "target": {
            "minLength": 1,
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "name",
          "target"
        ],
        "title": "AuthorizeAction",
        "type": "object"
      },
      "AuthorizeRequest": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/components/schemas/AuthorizeAction"
          },
          "client_reference_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Reference Id"
          },
          "requested_assurance": {
            "$ref": "#/components/schemas/AssuranceLevel",
            "default": "STANDARD"
          },
          "verification_receipt_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Verification Receipt Ids",
            "type": "array"
          }
        },
        "required": [
          "action"
        ],
        "title": "AuthorizeRequest",
        "type": "object"
      },
      "AuthorizeResponse": {
        "additionalProperties": false,
        "properties": {
          "assurance": {
            "$ref": "#/components/schemas/AssuranceLevel"
          },
          "decision": {
            "$ref": "#/components/schemas/PolicyDecision"
          },
          "evidence_score": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Score"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "identity": {
            "$ref": "#/components/schemas/AuthenticatedIdentityContext"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          },
          "reason_codes": {
            "items": {
              "examples": [
                "POLICY_ALLOWED",
                "PROVIDER_UNAVAILABLE"
              ],
              "pattern": "^[A-Z0-9_]+$",
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "receipt_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receipt Id"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "identity",
          "decision",
          "evidence_score",
          "assurance",
          "receipt_id",
          "price",
          "expires_at",
          "reason_codes"
        ],
        "title": "AuthorizeResponse",
        "type": "object"
      },
      "CapabilitiesResponse": {
        "additionalProperties": false,
        "properties": {
          "assurance": {
            "$ref": "#/components/schemas/AssuranceLevel"
          },
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "evidence_score": {
            "title": "Evidence Score",
            "type": "null"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          },
          "reason_codes": {
            "items": {
              "examples": [
                "POLICY_ALLOWED",
                "PROVIDER_UNAVAILABLE"
              ],
              "pattern": "^[A-Z0-9_]+$",
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "receipt_id": {
            "title": "Receipt Id",
            "type": "null"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "AVAILABLE",
              "DEGRADED"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "status",
          "assurance",
          "price",
          "expires_at",
          "reason_codes",
          "capabilities"
        ],
        "title": "CapabilitiesResponse",
        "type": "object"
      },
      "Capability": {
        "additionalProperties": false,
        "properties": {
          "escalation_strategies": {
            "items": {
              "$ref": "#/components/schemas/EscalationStrategy"
            },
            "title": "Escalation Strategies",
            "type": "array"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ProviderHealth"
          },
          "supported_assurance": {
            "items": {
              "$ref": "#/components/schemas/AssuranceLevel"
            },
            "title": "Supported Assurance",
            "type": "array"
          },
          "supported_modes": {
            "items": {
              "$ref": "#/components/schemas/VerificationMode"
            },
            "title": "Supported Modes",
            "type": "array"
          }
        },
        "required": [
          "name",
          "status",
          "supported_modes",
          "supported_assurance",
          "escalation_strategies"
        ],
        "title": "Capability",
        "type": "object"
      },
      "ComponentStatus": {
        "additionalProperties": false,
        "properties": {
          "health": {
            "$ref": "#/components/schemas/ProviderHealth"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "health"
        ],
        "title": "ComponentStatus",
        "type": "object"
      },
      "EscalationStrategy": {
        "enum": [
          "FAIL_CLOSED",
          "RETRY_WITH_BUDGET",
          "WEBHOOK",
          "QUEUE"
        ],
        "title": "EscalationStrategy",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JsonValue": {},
      "PolicyDecision": {
        "enum": [
          "ALLOW",
          "RETRY_HIGHER_ASSURANCE",
          "ESCALATE",
          "BLOCK"
        ],
        "title": "PolicyDecision",
        "type": "string"
      },
      "Price": {
        "additionalProperties": false,
        "properties": {
          "amount_minor": {
            "minimum": 0.0,
            "title": "Amount Minor",
            "type": "integer"
          },
          "currency": {
            "examples": [
              "USD"
            ],
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount_minor",
          "currency"
        ],
        "title": "Price",
        "type": "object"
      },
      "PricingItem": {
        "additionalProperties": false,
        "properties": {
          "assurance": {
            "$ref": "#/components/schemas/AssuranceLevel"
          },
          "operation": {
            "enum": [
              "verify",
              "authorize",
              "receipt",
              "capabilities",
              "pricing",
              "status"
            ],
            "title": "Operation",
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          }
        },
        "required": [
          "operation",
          "assurance",
          "price"
        ],
        "title": "PricingItem",
        "type": "object"
      },
      "PricingResponse": {
        "additionalProperties": false,
        "properties": {
          "assurance": {
            "$ref": "#/components/schemas/AssuranceLevel"
          },
          "evidence_score": {
            "title": "Evidence Score",
            "type": "null"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          },
          "prices": {
            "items": {
              "$ref": "#/components/schemas/PricingItem"
            },
            "title": "Prices",
            "type": "array"
          },
          "reason_codes": {
            "items": {
              "examples": [
                "POLICY_ALLOWED",
                "PROVIDER_UNAVAILABLE"
              ],
              "pattern": "^[A-Z0-9_]+$",
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "receipt_id": {
            "title": "Receipt Id",
            "type": "null"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "const": "AVAILABLE",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "status",
          "assurance",
          "price",
          "expires_at",
          "reason_codes",
          "prices"
        ],
        "title": "PricingResponse",
        "type": "object"
      },
      "ProviderHealth": {
        "enum": [
          "HEALTHY",
          "DEGRADED",
          "CIRCUIT_OPEN",
          "DISABLED"
        ],
        "title": "ProviderHealth",
        "type": "string"
      },
      "ReceiptResponse": {
        "additionalProperties": false,
        "properties": {
          "assurance": {
            "$ref": "#/components/schemas/AssuranceLevel"
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolicyDecision"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_score": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Score"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "identity": {
            "$ref": "#/components/schemas/AuthenticatedIdentityContext"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          },
          "reason_codes": {
            "items": {
              "examples": [
                "POLICY_ALLOWED",
                "PROVIDER_UNAVAILABLE"
              ],
              "pattern": "^[A-Z0-9_]+$",
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "receipt_id": {
            "format": "uuid",
            "title": "Receipt Id",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerificationStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "request_id",
          "identity",
          "receipt_id",
          "status",
          "decision",
          "evidence_score",
          "assurance",
          "price",
          "expires_at",
          "reason_codes"
        ],
        "title": "ReceiptResponse",
        "type": "object"
      },
      "StatusResponse": {
        "additionalProperties": false,
        "properties": {
          "assurance": {
            "$ref": "#/components/schemas/AssuranceLevel"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentStatus"
            },
            "title": "Components",
            "type": "array"
          },
          "evidence_score": {
            "title": "Evidence Score",
            "type": "null"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          },
          "reason_codes": {
            "items": {
              "examples": [
                "POLICY_ALLOWED",
                "PROVIDER_UNAVAILABLE"
              ],
              "pattern": "^[A-Z0-9_]+$",
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "receipt_id": {
            "title": "Receipt Id",
            "type": "null"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "HEALTHY",
              "DEGRADED",
              "UNAVAILABLE"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "status",
          "assurance",
          "price",
          "expires_at",
          "reason_codes",
          "components"
        ],
        "title": "StatusResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerificationMode": {
        "enum": [
          "INLINE",
          "PARALLEL",
          "ASYNC"
        ],
        "title": "VerificationMode",
        "type": "string"
      },
      "VerificationStatus": {
        "enum": [
          "VERIFIED",
          "CONTRADICTED",
          "INCONCLUSIVE",
          "PROVIDER_FAILED",
          "SYSTEM_FAILURE"
        ],
        "title": "VerificationStatus",
        "type": "string"
      },
      "VerifyRequest": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "minLength": 1,
            "title": "Claim",
            "type": "string"
          },
          "client_reference_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Reference Id"
          },
          "mode": {
            "$ref": "#/components/schemas/VerificationMode",
            "default": "INLINE"
          },
          "requested_assurance": {
            "$ref": "#/components/schemas/AssuranceLevel",
            "default": "STANDARD"
          },
          "subject": {
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "claim",
          "subject"
        ],
        "title": "VerifyRequest",
        "type": "object"
      },
      "VerifyResponse": {
        "additionalProperties": false,
        "properties": {
          "assurance": {
            "$ref": "#/components/schemas/AssuranceLevel"
          },
          "evidence_score": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Score"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "identity": {
            "$ref": "#/components/schemas/AuthenticatedIdentityContext"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          },
          "reason_codes": {
            "items": {
              "examples": [
                "POLICY_ALLOWED",
                "PROVIDER_UNAVAILABLE"
              ],
              "pattern": "^[A-Z0-9_]+$",
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "receipt_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receipt Id"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/VerificationStatus"
          }
        },
        "required": [
          "request_id",
          "identity",
          "status",
          "evidence_score",
          "assurance",
          "receipt_id",
          "price",
          "expires_at",
          "reason_codes"
        ],
        "title": "VerifyResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Outcome Contract",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/authorize": {
      "post": {
        "operationId": "authorize_v1_authorize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Authorize"
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "capabilities_v1_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Capabilities"
      }
    },
    "/v1/pricing": {
      "get": {
        "operationId": "pricing_v1_pricing_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricingResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Pricing"
      }
    },
    "/v1/receipts/{id}": {
      "get": {
        "operationId": "receipt_v1_receipts__id__get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Receipt"
      }
    },
    "/v1/status": {
      "get": {
        "operationId": "status_v1_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Status"
      }
    },
    "/v1/verify": {
      "post": {
        "operationId": "verify_v1_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify"
      }
    }
  }
}
